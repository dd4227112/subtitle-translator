# ════════════════════════════════════════════
# APPLICATION SETTINGS
# ════════════════════════════════════════════
APP_NAME="Laravel Sanctum API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.yourdomain.com

# ════════════════════════════════════════════
# SECURITY SETTINGS
# ════════════════════════════════════════════
# Force HTTPS in production
FORCE_HTTPS=true

# Trusted frontend origin for CORS
FRONTEND_URL=https://yourmobileapp.com

# Sanctum stateful domains (comma-separated)
SANCTUM_STATEFUL_DOMAINS=yourmobileapp.com

# ════════════════════════════════════════════
# DATABASE SETTINGS
# ════════════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_sanctum_api
DB_USERNAME=root
DB_PASSWORD=

# ════════════════════════════════════════════
# CACHE & SESSION
# ════════════════════════════════════════════
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ════════════════════════════════════════════
# LOGGING
# ════════════════════════════════════════════
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# ════════════════════════════════════════════
# MAIL CONFIGURATION (For notifications)
# ════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
